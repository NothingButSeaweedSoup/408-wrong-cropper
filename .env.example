# 复制成 backend/.env 后按需修改（backend/.env 已被 gitignore）。
# 首次启动如果没配 ZC_ADMIN_KEY，后端会自动生成一个随机兜底密钥写回 backend/.env。

# 管理员名单：这些用户名用普通账号登录后即可进入 /admin/ 管理后台（逗号分隔，支持中文名）
# 例：ZC_ADMIN_USERS=alice,bob
# 名字还没注册也没关系：注册该用户名后自动成为管理员，不用再改配置、也不用重启。
ZC_ADMIN_USERS=

# 兜底密钥：脚本调用、以及"还没有管理员账号"时进后台建账号用；日常登录用账号，不用它。
# 留空则首次启动自动生成并打印在控制台。
ZC_ADMIN_KEY=

# 服务端口与监听地址
ZC_PORT=18100
ZC_HOST=0.0.0.0

# 是否允许用户自助注册（管理后台里也能随时开关）
ZC_ALLOW_REGISTER=1
# 登录态有效期（天）
ZC_TOKEN_TTL_DAYS=60

# 数据目录（默认 ./data）
# ZC_DATA_DIR=E:\Date\Python\408-wrong-cropper\data

# 渲染与切题参数（一般不用改）
# ZC_RENDER_ZOOM=3.0
# ZC_NUMBER_X_RATIO=0.25
# ZC_QNO_MAX=47
