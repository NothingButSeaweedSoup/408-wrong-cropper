# 构建镜像时不要进上下文的东西（越小越快）
.git
.gitignore
.github

# 运行期数据与本地密钥：绝对不能进镜像（db.sqlite 是隐私数据，.env 是管理密钥）
data/
backend/.env
.env
.env.local

# 本地虚拟环境 / 依赖缓存
.venv/
.npm-cache/
node_modules/
admin/node_modules/
admin/dist/
__pycache__/
*.pyc

# 安卓端与测试（镜像里用不到）
android/build/
android/dist/
.android-sdk/
tests/

# 文档与编辑器
*.md
!README.md
.vscode/
.idea/
*.log
